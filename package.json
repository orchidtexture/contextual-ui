{
  "name": "contextual-ui-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "pnpm": {
    "allowBuilds": {
      "esbuild": true
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "test:production": "pnpm --filter starter-kit run test:production",
    "test:e2e": "pnpm --filter starter-kit run test:e2e",
    "verify:content": "pnpm build && pnpm -r --if-present test && pnpm -r lint && pnpm --filter starter-kit run test:production && pnpm --filter starter-kit run test:e2e",
    "release:beta": "./scripts/build-beta-release.sh"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "tsup": "^8.5.1"
  }
}
